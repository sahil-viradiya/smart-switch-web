{
  "name": "smart-switch-website",
  "version": "1.0.0",
  "description": "Smart Switch \u2014 architectural smart electrical controls marketing website",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "preview": "npm run build && npm run start",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "npm run type-check && npm run check:theme",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "clean:all": "rm -rf .next node_modules tsconfig.tsbuildinfo package-lock.json",
    "ai:init": "promptpilot-ai init",
    "ai:sync": "promptpilot-ai sync",
    "ai:stats": "promptpilot-ai stats",
    "check:theme": "node scripts/check-theme.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "privacy": "node scripts/privacy/data-tools.mjs",
    "check:trust": "node scripts/check-trust.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "exceljs": "^4.4.0",
    "next": "^14.2.14",
    "promptpilot-ai": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
