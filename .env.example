# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Inquiry storage (demo requests, contact messages, subscribers) ──────────────
# xlsx (default) writes data/inquiries.xlsx on the server. Needs a writable disk (VPS/Docker/local).
# sheets appends to a Google Sheet via an Apps Script web app (works on serverless hosts) — see docs/inquiry-sheet.md.
# both does both. An append-only data/inquiries.jsonl backup is always written unless INQUIRY_BACKUP=off.
INQUIRY_STORAGE=xlsx
# INQUIRY_XLSX_PATH=./data/inquiries.xlsx
# INQUIRY_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# INQUIRY_SHEET_SECRET=choose-a-long-random-string
# INQUIRY_TIMEZONE=Asia/Kolkata
# INQUIRY_RATE_LIMIT=8          # submissions allowed per IP …
# INQUIRY_RATE_WINDOW_SEC=600   # … per this many seconds
