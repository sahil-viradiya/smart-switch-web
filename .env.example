# -------------------------------------------------------------
# Smart Switch — Global Environment Configuration Example
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# -------------------------------------------------------------

# Environment
NODE_ENV=development

# Frontend (apps/web)
PORT_WEB=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend (apps/api)
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Security & Authentication (minimum 32 character random string in production)
JWT_SECRET=local-development-secret-change-in-production-only-32chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Database (Optional PostgreSQL / Neon connection string)
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_switch?sslmode=require
